{
  "name": "ledgerlyapps-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "node server/index.mjs",
    "backup": "node scripts/backup.mjs",
    "backup:restore": "node scripts/backup.mjs restore",
    "launch:check": "node scripts/launch-check.mjs",
    "test": "node --test tests/*.test.mjs",
    "format": "prettier --write src server shared tests scripts/*.mjs package.json",
    "format:check": "prettier --check src server shared tests scripts/*.mjs package.json"
  },
  "dependencies": {
    "nodemailer": "^10.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "vite": "^6.4.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
