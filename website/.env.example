PORT=3001
HOST=127.0.0.1
# Optional HTTPS notification receiver (only receives reference and service).
LEAD_WEBHOOK_URL=
# Leave SMTP fields blank until you have your email provider's credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ENQUIRY_TO=
# One inbox or both, e.g. Shayan@ledgerlyapps.com,Michael.Startin@ledgerlyapps.com
# Use a persistent private directory, outside dist/.
DATA_DIR=
BACKUP_DIR=
BACKUP_KEY=
# Only true behind the supplied private reverse proxy, never on an exposed Node port.
TRUST_PROXY=false
# Hostname only; also set the matching HTTPS siteUrl in shared/content.mjs.
SITE_DOMAIN=
